{
  "name": "@aws-cdk/permissions-snapshot",
  "version": "0.0.0",
  "private": true,
  "description": "AWS SDK permissions snapshot recording for CDK CLI integration tests",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "permissions-snapshot": "bin/index.js"
  },
  "scripts": {
    "clean": "tsc --build --clean",
    "build": "tsc --build",
    "build+test": "npm run build && npm run test",
    "lint": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern lib bin test",
    "package": "mkdir -p dist/js && mv $(npm pack) dist/js/",
    "test": "jest --passWithNoTests --updateSnapshot --coverage=false",
    "test:watch": "jest --watch",
    "watch": "tsc --build -w tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/types": "^3.609.0",
    "@smithy/types": "^3.3.0"
  },
  "devDependencies": {
    "@aws-cdk/cdk-build-tools": "0.0.0",
    "@aws-sdk/client-s3": "^3.632.0",
    "@aws-sdk/client-sts": "^3.632.0",
    "@aws-sdk/client-cloudformation": "^3.632.0",
    "jest": "^29",
    "ts-jest": "^29.4.6",
    "typescript": "~5.5.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aws/aws-cdk.git",
    "directory": "tools/@aws-cdk/permissions-snapshot"
  },
  "keywords": [
    "aws",
    "cdk",
    "permissions",
    "snapshot",
    "testing",
    "iam"
  ]
}
