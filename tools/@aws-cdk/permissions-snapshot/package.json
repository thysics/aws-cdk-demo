{
  "name": "@aws-cdk/permissions-snapshot",
  "version": "0.0.0",
  "private": true,
  "description": "AWS SDK v3 middleware for tracking permissions during CDK operations",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "tsc --build --clean",
    "build": "tsc --build",
    "build+test": "npm run build && npm run test",
    "lint": "eslint --ext .ts,.tsx --fix --no-error-on-unmatched-pattern lib bin test",
    "test": "jest --passWithNoTests --updateSnapshot",
    "test:watch": "jest --watch",
    "watch": "tsc --build -w tsconfig.json"
  },
  "dependencies": {
    "@smithy/types": "^3.0.0"
  },
  "devDependencies": {
    "@aws-cdk/cdk-build-tools": "0.0.0",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sts": "^3.600.0",
    "aws-sdk-client-mock": "^4.0.0",
    "jest": "^29",
    "ts-jest": "^29.4.6",
    "typescript": "~5.5.4"
  },
  "peerDependencies": {
    "@smithy/types": "^3.0.0"
  },
  "license": "Apache-2.0"
}
