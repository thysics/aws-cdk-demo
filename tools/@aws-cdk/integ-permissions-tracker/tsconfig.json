{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "strict": true,
    "alwaysStrict": true,
    "declaration": true,
    "inlineSourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "composite": true,
    "isolatedModules": true,
    "incremental": true,
    "outDir": "./lib",
    "rootDir": "./lib"
  },
  "include": ["lib/**/*.ts"],
  "exclude": ["**/*.d.ts", "test/**/*"]
}
